          "marking": ""
        }
      ],
      "telemetry": [
        {
          "host": "127.0.0.1",
          "port": 5512
        }
      ],
      "control": [
        {
          "host": "127.0.0.1",
          "port": 5513
        }
      ],
      "startup_timeout": 30.0
    }
  ]
