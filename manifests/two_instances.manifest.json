        "build/ssp/scenario.ssp",
        "--out-dir",
        "build/ssp/instances",
        "--offset-north-km",
        "0.0",
        "--offset-east-km",
        "5.0"
      ],
      "cwd": ".",
      "env": {
        "PYSOS_SCENARIO": "test_scenario",
        "PYSOS_TELEMETRY_PORT": "5512",
        "PYSOS_CONTROL_PORT": "5513"
      },
      "entities": [
        {
          "site": "1",
