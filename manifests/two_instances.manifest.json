{
  "schema": 1,
  "name": "high_altitude_intercept",
  "timing": "wall_clock",
  "instances": [
    {
      "name": "instance-1",
      "command": [
        "python3",
        "scripts/run_instance_process.py",
        "--instance",
        "1",
        "--source-ssp",
        "build/ssp/scenario.ssp",
        "--out-dir",
        "build/ssp/instances",
        "--offset-north-km",
        "0.0",
        "--offset-east-km",
        "0.0"
      ],
      "cwd": ".",
      "env": {
        "PYSOS_SCENARIO": "test_scenario",
        "PYSOS_TELEMETRY_PORT": "5510",
        "PYSOS_CONTROL_PORT": "5511"
      },
      "entities": [
        {
          "site": "1",
          "application": "1",
          "entity": "1",
          "marking": ""
        }
      ],
      "telemetry": [
        {
          "host": "127.0.0.1",
          "port": 5510
        }
      ],
      "control": [
        {
          "host": "127.0.0.1",
          "port": 5511
        }
      ],
      "startup_timeout": 30.0
    },
    {
      "name": "instance-2",
      "command": [
        "python3",
